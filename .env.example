NODE_ENV=development
PORT=3000

# --- Local development (no Turso needed) ---
# Path to a local SQLite file. Used automatically when TURSO_DATABASE_URL is not set.
DATABASE_PATH=./data/store.db

# --- Production on Vercel (required for data to persist) ---
# Connect via Vercel Dashboard → your project → Storage → Marketplace → Turso.
# It creates a free database and fills these in for you automatically.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-token

# Generate with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=PASTE_BCRYPT_HASH_HERE

# Long random string used to sign admin session cookies.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
